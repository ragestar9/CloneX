<?xml version="1.0" encoding="utf-8"?>
<!--
  App instance tile. Glass fill with a faint cyan rim so icons read as sitting
  on a holographic surface rather than floating on the raw background.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/zenith_glass" />
    <corners android:radius="4dp" />
    <stroke
        android:width="1dp"
        android:color="@color/zenith_cyan_rim" />
</shape>
