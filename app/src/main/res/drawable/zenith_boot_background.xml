<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash / boot background. Also serves as the shader fallback on devices
  below API 33, where RuntimeShader is unavailable.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/zenith_obsidian" />
        </shape>
    </item>

    <!-- Ambient cyan bloom from the centre, mirroring the shader's radial pulse -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="70%p"
                android:centerX="0.5"
                android:centerY="0.42"
                android:startColor="@color/zenith_cyan_glow"
                android:centerColor="#140A0C10"
                android:endColor="@color/zenith_obsidian" />
        </shape>
    </item>

    <!-- Purple wash in the lower corner: the "processing" accent -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="60%p"
                android:centerX="0.15"
                android:centerY="0.95"
                android:startColor="@color/zenith_purple_glow"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

</layer-list>
